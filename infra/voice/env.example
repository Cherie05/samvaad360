# Private server deployment settings. Copy to the host's secrets manager.
# Leave disabled until the authorised recipient and provider rehearsal are ready.
SAMVAAD_TELEPHONY_ENABLED=false
SAMVAAD_TWILIO_ACCOUNT_SID=
SAMVAAD_TWILIO_AUTH_TOKEN=
# Optional restricted API key for outgoing API requests; the account auth token
# remains required for incoming webhook signature validation.
SAMVAAD_TWILIO_API_KEY_SID=
SAMVAAD_TWILIO_API_KEY_SECRET=
SAMVAAD_TWILIO_VERIFY_SERVICE_SID=
SAMVAAD_TWILIO_FROM_NUMBER=
# HTTPS origin of this API, not the Streamlit website, with no trailing slash.
SAMVAAD_TELEPHONY_PUBLIC_URL=
# Both the country/prefix policy AND exact authorised pilot numbers are required.
SAMVAAD_TELEPHONY_PERMITTED_PREFIXES=
SAMVAAD_TELEPHONY_AUTHORIZED_TEST_NUMBERS=
SAMVAAD_DB_PATH=/var/lib/samvaad/pilot.db
# Load token-to-operator mappings privately. Do not commit the token JSON.
SAMVAAD_API_TOKEN_FILE=/run/secrets/samvaad_api_tokens
