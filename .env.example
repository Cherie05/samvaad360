SAMVAAD_BACKEND=local
SAMVAAD_DB_PATH=.local/samvaad.db
SAMVAAD_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Set an explicit bearer-token map if launching FastAPI independently.
# Generate long random tokens; keep the real mapping in .env or .local/api-tokens.json.
# SAMVAAD_API_TOKENS_JSON={"replace-with-a-random-token":"arjun"}
# Cloud setup is a later stage; local mode needs no account or API keys.
